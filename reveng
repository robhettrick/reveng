cmd_synth() {
  parse_flags "$SYNTH_DEFAULT_MODEL" --analyses-only --prd-only --force -- "$@"

  if [[ "$SHOW_HELP" == "true" ]]; then
    cat <<'EOF'
Usage: reveng synth [options]

Runs the four analysis agents and synthesises results into a Product
Requirements Document using the product-manager agent.

Each analyst runs as its own Claude session, so each gets a full context
rather than a share of one. Existing analysis files are reused; analysts run
only for missing outputs. Analyses are checked for completeness before the
PRD is synthesised.

Options:
  -m, --model MODEL   Claude model to use (default: opus)
  -v, --verbose        Show Claude commands and raw output
  --dry-run            Print what would be executed without running
  --analyses-only      Run the analysts and stop before the PRD
  --prd-only           Skip the analysts and synthesise the PRD only
  --force              Skip all completeness checks (reuse and PRD gate)
  --run-id ID          Label this run in the metrics log
  -h, --help           Show this help message
EOF
    return 0
  fi

  if [[ "$SYNTH_ANALYSES_ONLY" == "true" && "$SYNTH_PRD_ONLY" == "true" ]]; then
    echo "Error: --analyses-only and --prd-only are mutually exclusive." >&2
    return 1
  fi

  validate_inputs synth
  init_run_id "synth" "$MODEL"

  check_section_counts_in_sync

  if [[ "$SYNTH_PRD_ONLY" != "true" ]]; then
    cmd_synth_analyses || return 1
  fi

  if [[ "$SYNTH_ANALYSES_ONLY" == "true" ]]; then
    # Validate before claiming completion, otherwise this can report success
    # over files that the very next `synth --prd-only` will reject.
    if [[ "$DRY_RUN" != "true" ]]; then
      validate_analyses "$([[ "$SYNTH_FORCE" == "true" ]] && echo false || echo true)" || return 1
    fi
    echo "Analyses complete. Run 'reveng synth --prd-only' to produce the PRD."
    return 0
  fi

  # Gate: never synthesise a PRD from truncated analyses without being asked to.
  if [[ "$DRY_RUN" != "true" ]]; then
    validate_analyses "$([[ "$SYNTH_FORCE" == "true" ]] && echo false || echo true)" || return 1
  fi

  echo "▸ Synthesising PRD"
  REVENG_PHASE="/synth/prd"
  run_claude \
    "Run the \`product-manager\` agent to produce the PRD. All four analysis files already exist in output/ — do not launch any analyst agents; read the four analysis files and synthesise output/PRD.md from them." \
    "$MODEL" \
    "$VERBOSE" \
    "$DRY_RUN"
}

# Run each analyst as its own top-level Claude session, skipping those whose
# output already exists. Sequential rather than parallel: these are large,
# long-running jobs and each needs a full context to itself.
cmd_synth_analyses() {
  local -a pending=()
  local agent out

  # Reuse only what is actually usable. Validating here rather than after the
  # fact closes the loop: an incomplete analysis is regenerated automatically
  # instead of being reused and then reported as a blocking error the user has
  # to resolve by deleting the file themselves.
  #
  # --force reaches this decision too. Without it, a workspace whose agent files
  # predate a section-count change would regenerate every analysis on every
  # invocation — the most expensive runs in the tool — with no way to opt out,
  # because --force only reached the PRD gate.
  local detail entry sections
  for entry in "${ANALYSIS_AGENTS[@]}"; do
    IFS='|' read -r agent out sections <<<"$entry"

    # Recover an orphaned .prev before deciding anything. A run killed outright
    # (SIGKILL, OOM, host death) dies between moving $out aside and the agent
    # writing its replacement, leaving a complete analysis in .prev and nothing
    # at $out. Nothing else here produces that state, so restoring is
    # unambiguous — and it saves a full analyst pass.
    if [[ "$DRY_RUN" != "true" && -e "$out.prev" && ! -f "$out" ]]; then
      if mv -f "$out.prev" "$out" 2>/dev/null; then
        echo "▸ Recovered $out from $out.prev (an earlier run was interrupted)"
      fi
    fi
    if [[ -f "$out" ]]; then
      if [[ "${SYNTH_FORCE:-false}" == "true" ]]; then
        echo "▸ Reusing existing $out (--force: not checked)"
        continue
      fi
      if detail=$(check_analysis_complete "$out" "$sections"); then
        echo "▸ Reusing existing $out"
        continue
      fi
      echo "▸ Regenerating $out ($detail)"
    fi
    pending+=("$agent|$out|$sections")
  done

  if [[ ${#pending[@]} -eq 0 ]]; then
    echo "All four analyses already present."
    return 0
  fi

  for entry in "${pending[@]}"; do
    IFS='|' read -r agent out sections <<<"$entry"
    echo "▸ Running $agent → $out"
    # Clear any stale file first. The agents Write once and then append, so an
    # agent that finds a truncated file already on disk can resume appending to
    # it, producing a merged document that then passes the section count and
    # reaches the PRD step. Skipped on a dry run, which must not touch outputs.
    # Move the stale file aside rather than deleting it: the agents Write once
    # then append, so a leftover file would be resumed and merged. But a failed
    # or interrupted run must not destroy an analysis that cost real money —
    # keep it as .prev and only discard once the new one is in place.
    local prev=""
    if [[ "$DRY_RUN" != "true" && -f "$out" ]]; then
      prev="$out.prev"
      # Both files present is the one ambiguous case: .prev may hold a good
      # analysis while $out holds an interrupted run's truncated output, and
      # moving $out over .prev would destroy the better copy. The $out-absent
      # case is already recovered during planning, above.
      if [[ -e "$prev" ]]; then
        echo "Error: $prev already exists alongside $out." >&2
        echo "       One of them may be an interrupted run's partial output," >&2
        echo "       and this cannot tell which. Compare both, then remove or" >&2
        echo "       rename $prev and re-run." >&2
        return 1
      fi
      # An analyst run can last hours, so an interrupt inside this window is
      # likely. Without a trap, SIGINT kills the script between the move and the
      # restore, leaving $out gone and .prev orphaned — the next run then
      # regenerates from scratch, which is what .prev exists to avoid.
      # shellcheck disable=SC2064
      trap "restore_prev_on_interrupt '$out' '$prev' '$sections'; trap - INT TERM; exit 130" INT TERM
      if ! mv -f "$out" "$prev" 2>/dev/null; then
        # Do not fall through: a surviving stale file is exactly what this
        # guard exists to prevent — the agent would resume appending to it and
        # produce a merged document that then passes the section count.
        echo "Error: could not move $out aside (to $prev)." >&2
        echo "       Refusing to run $agent over the existing file." >&2
        trap - INT TERM
        return 1
      fi
    fi
    REVENG_PHASE="/synth/analysis/$agent"
    if ! run_claude \
      "Run the \`$agent\` agent. Write its complete analysis to $out." \
      "$MODEL" \
      "$VERBOSE" \
      "$DRY_RUN"; then
      trap - INT TERM
      if [[ -n "$prev" && -f "$prev" ]]; then
        mv -f "$prev" "$out" 2>/dev/null || true
        echo "Error: $agent failed. Restored the previous $out." >&2
      else
        echo "Error: $agent failed. $out may be missing or incomplete." >&2
      fi
      return 1
    fi
    # If a file we just regenerated still fails, say so and stop. Deferring to
    # validate_analyses would let the next invocation regenerate it again on the
    # same terms — a full analyst pass per run with no way out but --force.
    #
    # The previous file is still held as .prev at this point: discarding it
    # before this check would leave the worse of the two on disk when the new
    # one turns out to be incomplete.
    if [[ "$DRY_RUN" != "true" && "${SYNTH_FORCE:-false}" != "true" ]]; then
      if ! detail=$(check_analysis_complete "$out" "$sections"); then
        echo "Error: $agent produced $out but it is still incomplete ($detail)." >&2
        if [[ -n "$prev" && -f "$prev" ]]; then
          # The new file is kept alongside, so --force has something to reuse
          # and the advice below names what will actually be used.
          mv -f "$out" "$out.incomplete" 2>/dev/null || true
          mv -f "$prev" "$out" 2>/dev/null || true
          echo "       Restored the previous $out; the new one is at $out.incomplete." >&2
          echo "       Re-running will repeat this. Check the agent's mandatory" >&2
          echo "       section list against what it wrote. --force will proceed" >&2
          echo "       with the restored previous file, not the new one." >&2
        else
          echo "       Re-running will repeat this. Check the agent's mandatory" >&2
          echo "       section list against what it wrote, or pass --force to" >&2
          echo "       proceed with the file as it stands." >&2
        fi
        trap - INT TERM
        return 1
      fi
    fi

    # New file passed — the previous one is now safe to discard and the
    # interrupt window is closed.
    trap - INT TERM
    if [[ -n "$prev" ]]; then
      rm -f "$prev"
    fi
  done

  # Explicit: the function's status must not depend on whatever the last
  # statement in the loop happens to evaluate to. A trailing `[[ ... ]] && cmd`
  # that tests false made this return 1 on every fresh workspace — after
  # running all four analysts — aborting synth before the PRD with no message.
  return 0
}

